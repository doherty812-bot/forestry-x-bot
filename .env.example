# X API (OAuth 1.0a) — 投稿（approve）時のみ必要。GitHub Secrets と同名
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OpenAI（ChatGPT 系）— 下書き生成に必須
OPENAI_API_KEY=
# 任意。互換エンドポイントを使う場合のみ（空なら公式）
# OPENAI_BASE_URL=
# 任意。未設定または空なら gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini

# Grok（xAI）— 下書き生成に必須。どちらか一方で可（XAI_API_KEY 優先）
XAI_API_KEY=
# GROK_API_KEY=
# 任意。未設定または空なら https://api.x.ai/v1
# XAI_BASE_URL=https://api.x.ai/v1
# 任意。未設定または空なら grok-3-mini（xAI ダッシュボードのモデル名に合わせて変更可）
# GROK_MODEL=grok-3-mini

# 実投稿は approve 時のみ。1 のときだけ投稿を許可
# CONFIRM_LIVE_POST=1

# X Premium 向けソフト上限（最終投稿テキスト）。未設定なら 8000
# MAX_POST_CHARS=8000
# 下書きに添付するソース数（1〜5）。未設定なら 3
# MAX_SOURCES=3
# 生成 max_tokens。未設定なら 1200
# GEN_MAX_TOKENS=1200

# --- Obsidian（下書き生成前に参照。秘密・個人情報を vault に置かない）---
# 優先A: リポジトリ内 obsidian/ または vault-sync/（.md があるとき。Actions 向け）
# 優先B: 下記（ローカル Windows / self-hosted）。未設定時もコード既定で同パスを試す
# Actions の hosted Linux ではローカル vault に届かない → A の同期 or 警告して空コンテキスト続行
OBSIDIAN_VAULT_PATH=C:\Users\info\Obsidian Vault
# OBSIDIAN_SYNC_PATH=
# OBSIDIAN_MISSING_POLICY=warn  # warn=警告して空コンテキストで続行 / fail=下書き中止
# OBSIDIAN_MAX_FILES=8
# OBSIDIAN_MAX_CHARS=6000

# --- Cloud Agent / ローカルから承認 workflow を起動する場合のみ ---
# 値はチャット・PR・コミットに書かない。Cursor Secrets またはローカル .env のみ。
# WORKFLOW_DISPATCH_PAT=   # 推奨（GitHub PAT。workflow_dispatch 可能な権限）
# GH_PAT=                  # 代替名（未設定時のみ参照）

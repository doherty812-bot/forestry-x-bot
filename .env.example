# X API (OAuth 1.0a) — 投稿（approve）時のみ必要。GitHub Secrets と同名
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OpenAI（ChatGPT 系）— 下書き生成に必須
OPENAI_API_KEY=
# 任意。互換エンドポイントを使う場合のみ（空なら公式）
# OPENAI_BASE_URL=
# 任意。未設定または空なら gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini

# Grok（xAI）— 下書き生成に必須。どちらか一方で可（XAI_API_KEY 優先）
XAI_API_KEY=
# GROK_API_KEY=
# 任意。未設定または空なら https://api.x.ai/v1
# XAI_BASE_URL=https://api.x.ai/v1
# 任意。未設定または空なら grok-3-mini（xAI ダッシュボードのモデル名に合わせて変更可）
# GROK_MODEL=grok-3-mini

# 実投稿は approve 時のみ。1 のときだけ投稿を許可
# CONFIRM_LIVE_POST=1
